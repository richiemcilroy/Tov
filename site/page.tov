// ---------------------------------------------------------------- how a build works

// One program through the compiler, stage by stage: what goes in, what each stage makes of it
// (real output: tov check, tov build --emit-c trimmed and with its generated names shortened, and
// tov build --time on an M4 Max).
type Stage = { id: string, name: string, metric: string, title: string, body: string, art: string }

const stages: Stage[] = [
  {
    id: "src",
    name: "TypeScript",
    metric: "shapes.tov",
    title: "Your agent writes TypeScript",
    body: "Tov reads TypeScript's syntax and types, with <code>int</code> and <code>f64</code> for numbers, and Bun's and Node's APIs. It leaves out what makes a program hard to follow: <code>any</code>, <code>null</code> and <code>==</code>.",
    art: [
      `<span class="k">type</span> Shape =`,
      `  | { kind: <span class="s">"circle"</span>, r: <span class="k">f64</span> }`,
      `  | { kind: <span class="s">"rect"</span>, w: <span class="k">f64</span>, h: <span class="k">f64</span> }`,
      ``,
      `<span class="k">function</span> area(s: Shape): <span class="k">f64</span> {`,
      `  <span class="k">switch</span> (s.kind) {`,
      `    <span class="k">case</span> <span class="s">"circle"</span>:`,
      `      <span class="k">return</span> Math.PI * s.r * s.r`,
      `    <span class="k">case</span> <span class="s">"rect"</span>:`,
      `      <span class="k">return</span> s.w * s.h`,
      `  }`,
      `}`,
    ].join("\n"),
  },
  {
    id: "check",
    name: "Check",
    metric: "0.3 ms",
    title: "Tov checks every line",
    body: "The checker, written in Rust, catches what TypeScript lets through: a call that can fail without <code>try</code>, a value shared where it should be copied, a <code>switch</code> that misses a case. Each error has a code and, where the fix is clear, the edit that makes it, which <code>tov check --json</code> hands to your agent.",
    art: [
      `<span class="d">// without the "rect" case</span>`,
      `<span class="d">$</span> tov check shapes.tov`,
      `<span class="e">error[F0301]</span> shapes.tov:6:11: \`switch\` is not`,
      `  exhaustive: missing <span class="s">"rect"</span>`,
      `    6 |   switch (s.kind) {`,
      `  <span class="f">fix</span>: add case <span class="s">"rect"</span>`,
    ].join("\n"),
  },
  {
    id: "c",
    name: "C",
    metric: "0.2 ms",
    title: "It writes the program as C",
    body: "The whole program becomes one C file. Records become structs and a union becomes a tagged union, so <code>switch (s.kind)</code> is a switch on an integer. Values are reference-counted, with the counting written into the C, so there's no garbage collector to pause the program.",
    art: [
      `<span class="k">struct</span> Shape {`,
      `    <span class="k">uint32_t</span> tag;`,
      `    <span class="k">union</span> { Circle m0; Rect m1; } u;`,
      `};`,
      ``,
      `<span class="k">static double</span> area(Shape s) {`,
      `    <span class="k">switch</span> (s.tag) {`,
      `    <span class="k">case</span> 0: <span class="k">return</span> 3.141592653589793 * s.u.m0.r * s.u.m0.r;`,
      `    <span class="k">case</span> 1: <span class="k">return</span> s.u.m1.w * s.u.m1.h;`,
      `    }`,
      `}`,
    ].join("\n"),
  },
  {
    id: "bin",
    name: "Binary",
    metric: "55 ms · 34 KB",
    title: "clang makes one binary",
    body: "clang compiles that C with Tov's runtime, a C library with the event loop, the HTTP server and client, and Tov's strings, arrays and maps. The runtime is compiled once and cached, so most of a build is clang's. A program that imports an npm package also carries the package and JavaScriptCore, the engine Bun uses, to run it.",
    art: [
      `<span class="d">$</span> tov build shapes.tov --time`,
      `check 0.3 ms, generate 0.2 ms, C compile 55 ms`,
      `build: shapes`,
      `<span class="d">$</span> ls -lh shapes`,
      `<span class="a">34K</span> shapes`,
      `<span class="d">$</span> ./shapes`,
      `circle: 3.14`,
      `rect: 6.00`,
    ].join("\n"),
  },
]

// The pipeline: a row of stages to pick from, and the picked one's story beside what it makes
// (no script: radio inputs and :checked, as the race does).
function renderBuild(): string {
  const inputs = stages.map((st, i) => `<input type="radio" name="stage" id="stage-${st.id}" class="stage-pick"${i === 0 ? " checked" : ""}>`).join("")
  const flow = stages.map((st, i) => `<li><label for="stage-${st.id}"><span class="fl-n">${i + 1}</span><b>${st.name}</b><i>${st.metric}</i></label></li>`).join("")
  const panels = stages.map(st => `<div class="fp fp-${st.id}"><div class="fp-text"><h3>${st.title}</h3><p>${st.body}</p></div><pre>${st.art}</pre></div>`).join("")
  const rules = stages.map(st => `#stage-${st.id}:checked ~ .fps .fp-${st.id} { display: grid; } #stage-${st.id}:checked ~ .flow label[for="stage-${st.id}"] { border-color: var(--crust); background: var(--panel); box-shadow: 0 1px 2px rgba(0,0,0,.06); } #stage-${st.id}:checked ~ .flow label[for="stage-${st.id}"] .fl-n { background: var(--crust); color: #26262B; } #stage-${st.id}:focus-visible ~ .flow label[for="stage-${st.id}"] { outline: 2px solid var(--crust); outline-offset: 2px; }`).join("\n")
  return `<style>${rules}</style><div class="build">${inputs}<ol class="flow" aria-label="What tov build does">${flow}</ol><div class="fps">${panels}</div></div>`
}

// small: copying, and the singalong (singalong.js, with the song, fetched only when it's asked for)
const script = `
let sing;
function loadSing() {
  sing = sing || new Promise((done, failed) => {
    const s = document.createElement("script");
    s.src = "/singalong.js";
    s.onload = done;
    s.onerror = () => { sing = undefined; failed(); };
    document.head.appendChild(s);
  });
  return sing;
}
for (const a of document.querySelectorAll("[data-sing]")) {
  a.addEventListener("pointerenter", () => loadSing().catch(() => {}), { once: true });
  a.addEventListener("click", e => { e.preventDefault(); loadSing().then(() => window.tovSingalong(a)); });
}
if (location.hash === "#singalong") loadSing().then(() => window.tovSingalong());
for (const b of document.querySelectorAll("[data-copy]")) {
  b.addEventListener("click", async () => {
    const text = document.getElementById(b.dataset.copy).textContent;
    try { await navigator.clipboard.writeText(text); }
    catch (e) {
      const t = document.createElement("textarea");
      t.value = text; document.body.appendChild(t); t.select(); document.execCommand("copy"); t.remove();
    }
    const label = b.querySelector(".label"), was = label.textContent;
    label.textContent = b.dataset.done; b.classList.add("done");
    setTimeout(() => { label.textContent = was; b.classList.remove("done"); }, 1800);
  });
}`

// The mascot, inline in the header so its parts can move: on hover it darts forward and hovers,
// its wing beating too fast to see, its speed lines streaming and its eye blinking (style.tov).
const bird = `<svg class="hb" viewBox="0 0 120 96" width="50" height="40" aria-hidden="true">
<defs><filter id="hb-r" x="-20%" y="-20%" width="140%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.022" numOctaves="2" seed="3"/><feDisplacementMap in="SourceGraphic" scale="1.6"/></filter></defs>
<g filter="url(#hb-r)" stroke-linecap="round" stroke-linejoin="round">
<g class="hb-lines"><path d="M6 50h12M2 62h14M10 74h8" fill="none" stroke="currentColor" stroke-width="4" opacity=".8"/></g>
<g class="hb-bird">
<path d="M40 68 L22 74 Q24 79 30 78 L26 84 Q31 87 35 83 L46 72 Z" fill="#E4A95A" stroke="#26262B" stroke-width="3"/>
<g class="hb-blur"><path d="M58 40 Q44 20 48 6" fill="none" stroke="#26262B" stroke-width="2.4" opacity=".22"/><path d="M60 41 Q54 22 62 8" fill="none" stroke="#26262B" stroke-width="2.4" opacity=".22"/></g>
<path d="M97 40 C97 27 89 21 79 21 C69 21 63 27 61 35 C53 42 42 52 37 63 C35 70 39 74 47 72 C62 70 80 63 93 50 C96 47 97 44 97 40 Z" fill="#E4A95A" stroke="#26262B" stroke-width="3.4"/>
<path d="M48 69 C62 67 78 60 89 50" fill="none" stroke="#F4D6A2" stroke-width="5"/>
<g class="hb-wing"><path d="M66 39 C54 35 40 26 33 12 C39 11 44 14 47 17 C46 11 47 7 50 5 C56 10 60 18 62 24 C64 20 67 18 70 18 C71 26 70 32 68 37 Z" fill="#FFF3DC" stroke="#26262B" stroke-width="3.1"/><path d="M47 18 C52 25 57 30 64 34 M62 25 C63 29 64 32 66 35" fill="none" stroke="#26262B" stroke-width="1.8" opacity=".35"/></g>
<path d="M96 36 L118 30" fill="none" stroke="#26262B" stroke-width="3.6"/>
<g class="hb-eye"><circle cx="84" cy="35" r="4.6" fill="#26262B"/><circle cx="85.7" cy="33.4" r="1.5" fill="#fff"/></g>
<ellipse cx="81" cy="45" rx="5" ry="2.8" fill="#F08F8A" opacity=".7"/>
