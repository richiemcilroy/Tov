// ---------------------------------------------------------------- the page

// The page, with `footer` (HTML) saying how it was made: served by site/server.tov, or written
// out by site/build.tov.
export function renderPage(footer: string): string {
  return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tov, the programming language for coding agents</title>
<meta name="description" content="Tov is a programming language for coding agents. It reads like TypeScript, its errors come with the edit that fixes them, and it builds native binaries that beat Rust's.">
<meta name="theme-color" content="#FBFBFA">
<meta property="og:type" content="website">
<meta property="og:url" content="https://tov.sh/">
<meta property="og:site_name" content="Tov">
<meta property="og:title" content="Tov: faster than Rust, written like TypeScript">
<meta property="og:description" content="A programming language for coding agents. It reads like TypeScript and builds native binaries that beat Rust's.">
<meta property="og:image" content="https://tov.sh/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Tov: faster than Rust, written like TypeScript. Tov serves 242k requests a second, Rust 216k and Bun 111k.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Tov: faster than Rust, written like TypeScript">
<meta name="twitter:description" content="A programming language for coding agents. It reads like TypeScript and builds native binaries that beat Rust's.">
<meta name="twitter:image" content="https://tov.sh/og.png">
<link rel="icon" href="/logo.svg" type="image/svg+xml">
<link rel="icon" href="/icon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/schibsted-grotesk.woff2" as="font" type="font/woff2" crossorigin>
<style>${css}</style>
<script>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
<script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<pre id="prompt" hidden>${esc(agentPrompt)}</pre>
<pre id="install" hidden>${installLine}</pre>
<div class="wrap">
  <header class="top">
    <a class="brand" href="/" aria-label="Tov, home">${bird}<span class="name">tov<small>v0.1.0 experimental</small></span></a>
    <nav aria-label="Main">
      <ul>
        <li class="optional"><a href="#speed">Benchmarks</a></li>
        <li><a href="${repo}/blob/main/docs/spec.md">Spec</a></li>
        <li><a href="${repo}">GitHub</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <div class="hero">
      ${singLink}
      <h1><span>Faster than Rust.</span> <span>Written like TypeScript.</span></h1>
      <p class="lede">A programming language for coding agents. Your agent already writes TypeScript, so it can already write Tov, and when it gets something wrong the compiler hands back the edit that fixes it. What it ships is a native binary that <strong>beats Rust's</strong>.</p>
      <div class="actions">
        ${copyButton("prompt", "Copy the prompt for your agent", "Copied. Paste it into your agent", "primary")}
        ${starButton}
      </div>
      <div class="install"><code><span class="d">$</span> ${installLine}</code>${copyButton("install", "Copy", "Copied", "small")}</div>

      ${renderRaces()}
    </div>

    <section id="how">
      <h2>What happens when Tov builds a program</h2>
      <p class="intro">Tov is a compiler. It checks the TypeScript your agent wrote, writes it out as C and hands that to clang, so what you ship is one native binary with nothing to install next to it.</p>
      ${renderBuild()}
    </section>

    <section id="agents">
      <h2>How an agent writes Tov</h2>
      <div class="loop" role="group" aria-label="How an agent works with Tov">
        <div class="step"><h3><span>1</span>Your agent writes TypeScript</h3><pre>${written}</pre></div>
        <div class="step"><h3><span>2</span>Tov hands back the fix</h3><pre>${checked}</pre></div>
        <div class="step"><h3><span>3</span>You ship a native binary</h3><pre>${shipped}</pre></div>
      </div>
      <div class="reasons">
        <div>
          <h3>It's TypeScript</h3>
          <p>With the APIs your agent knows from Bun and Node. <code>Bun.serve</code>, <code>fetch</code>, <code>node:fs</code>, <code>async</code>/<code>await</code> and npm packages work as it expects.</p>
        </div>
        <div>
          <h3>Less to get wrong</h3>
          <p>There's no <code>any</code>, <code>null</code> or <code>==</code>, and a call that can fail is marked <code>try</code>. If code looks like TypeScript it behaves like TypeScript, and if it can't, it doesn't compile.</p>
        </div>
        <div>
          <h3>A 42 ms compile</h3>
          <p><code>--watch</code> restarts the program on save, and <code>tov test</code> runs the tests that sit next to the code.</p>
        </div>
      </div>
    </section>

    <section id="speed">
      <div class="bench">
        <h2>Against Rust, C, Bun and Node</h2>
        <p class="intro">Tov compiles to C and counts references instead of collecting garbage, so there are no collector pauses and the binaries stay small.</p>
        ${renderBench()}
        <p class="fine">Measured on an Apple M4 Max, and each program prints the same output in every language. Tov checks integer overflow by default; Rust's release builds don't. <a href="${repo}/tree/main/bench">Method and every result</a>.</p>
      </div>
    </section>

    <section id="cap">
      <div class="cap-head">
        <p class="pair" aria-hidden="true">${capLogo}<span>×</span><img src="/logo.svg" alt="" width="55" height="44"></p>
        <h2>Trying Tov on Cap</h2>
        <p class="intro">Cap is our open-source screen recorder. We've tried two parts of its video pipeline on Tov: a new encoder written in Tov, and the media server Cap already has, compiled by Tov as it is. <strong>Neither runs in Cap's production yet.</strong></p>
      </div>
      <div class="cap-grid">
        <article class="cap-card enc">
          <h3>A screen encoder, written in Tov</h3>
          <p>Every Cap recording ends up as H.264 video. We wrote an encoder for it in Tov, tuned for what's on a screen, and compared it with x264 at the same picture quality. <a href="https://github.com/CapSoftware/Cap/tree/capcodec-encoder-aa45/capcodec">The encoder is on GitHub</a>.</p>
          <p class="cap-big"><b>5.2×</b><span>faster than x264, on average</span></p>
          ${renderClips()}
          <dl class="cap-stats">
            <div><dt>46 MB</dt><dd>of memory at its peak (x264: 377)</dd></div>
            <div><dt>561 KB</dt><dd>the whole encoder (x264: 1.3 MB)</dd></div>
          </dl>
          <p class="cap-fine">12 screen recordings at 1080p, on one thread, against x264's veryfast preset. <a href="https://github.com/CapSoftware/Cap/blob/capcodec-encoder-aa45/apps/media-server/capcodec-benchmarks.md">Every result</a>.</p>
        </article>
        <article class="cap-card ms">
          <h3>The media server, unchanged</h3>
          <p>Cap's media server is a Bun app (Hono, zod and FFmpeg) that probes uploaded videos and pulls out their audio. Tov runs it without changing a line; the file below is the whole port. Cap still serves it with Bun.</p>
          <pre class="code">${npmExample}</pre>
          <ul class="facts">
            <li><b>105 ms</b><span>to start (Bun: 120)</span></li>
            <li><b>27% less</b><span>CPU for each video it reads</span></li>
            <li><b>129 MB</b><span>of memory at its peak under load (Bun: 143)</span></li>
          </ul>
          <p class="cap-fine">Against Bun 1.4 on an Apple M4 Max. <a href="${repo}/tree/main/bench/cap-media">Method and every result</a>.</p>
        </article>
      </div>
    </section>

    <section id="start">
      <div class="start">
        <div>
          <h2>Start with your agent</h2>
          <p>Paste this into your agent. It installs Tov, reads <a href="/llms.txt">llms.txt</a>, and from then on checks its own work with <code>tov check --json</code>.</p>
        </div>
        <div class="prompt-card">
          <pre>${esc(agentPrompt)}</pre>
          ${copyButton("prompt", "Copy prompt", "Copied", "primary")}
        </div>
      </div>
    </section>

    <section id="status">
      <h2>What works today</h2>
      <div class="status">
        <div class="yes">
          <h3>Works</h3>
          <ul>
            <li>Command-line programs and web servers</li>
            <li>Records, unions, generics, classes, interfaces and checked errors</li>
            <li><code>async</code>/<code>await</code>, timers, <code>fetch()</code> over HTTP and HTTPS</li>
            <li>Bun's server API and a Node-style standard library</li>
            <li>npm packages, including native addons</li>
            <li>macOS and Linux</li>
          </ul>
        </div>
        <div class="not">
          <h3>Not yet</h3>
          <ul>
            <li>Windows</li>
            <li>A package manager of its own (install with npm or Bun)</li>
            <li>TLS sockets and worker threads for npm packages</li>
            <li>Tuples, enums and a few other TypeScript features (see the spec)</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</div>

<footer>
  <div class="wrap">
    <img src="/logo.svg" alt="" width="44" height="35">
    <div class="foot">
      <p class="by">From the team behind <a class="cap-link" href="https://cap.so">${capMark("cap-mark", 18)}Cap</a>, the open-source screen recorder.</p>
      <p>${footer}</p>
    </div>
  </div>
</footer>
<script>${script}</script>
</body>
</html>
`
}

// ---------------------------------------------------------------- llms.txt

// The language for agents (llmstxt.org): how to work with Tov, then the spec in full.
export function renderLlms(spec: string): string {
  return `# Tov

> Tov is a programming language for coding agents: TypeScript's syntax, compiled to native binaries faster than Rust's. If code looks like TypeScript it behaves like TypeScript, or it is a compile error with a code and a fix.

## Working with Tov

- Install: \`${installLine}\` (builds from source; needs git and a C compiler, installs Rust if missing).
- Source files end in \`.tov\`. A program is a script, or has \`function main()\`.
- After every edit run \`tov check --json <files>\`. Each diagnostic has a code, a message and fixes; apply the fixes marked "safe" as they are. \`tov explain <CODE>\` describes a code.
- \`tov run main.tov\` builds and runs; \`tov build main.tov -o app\` writes one native binary; \`tov test\` runs every \`test(...)\`; \`--watch\` rebuilds on save.
- npm packages: install them with npm or Bun, then import them. Values from JavaScript have the type \`Js\`; convert them with \`as\` (checked), and mark calls into JavaScript \`try\`.
- Repository: ${repo}

## The language: what differs from TypeScript

${spec}`
}
