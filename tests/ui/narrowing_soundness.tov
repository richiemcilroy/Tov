// Narrowings don't survive assignments in nested blocks, loops or closures; branches join.
type T = { v: int, left: T | undefined }
function f(c: bool, x0: int | undefined): int {
  let x = x0
  if (x !== undefined) {
    if (c) {
      x = undefined
    }
    return x + 1
  }
  return 0
}
function g(c: bool): int {
  let t: T = { v: 1, left: { v: 2, left: undefined } }
  if (t.left !== undefined) {
    if (c) {
      t.left = undefined
    }
    return t.left.v
  }
  return 0
}
function f2(x0: int | undefined): int {
  let x = x0
  if (x === undefined) {
    x = 7
  }
  return x + 1
}
function g2(x0: int | undefined, c: bool): int {
  let x = x0
  if (x !== undefined) {
    let y = 0
    while (c) {
      y = x
      break
    }
    return x + y
  }
  return 0
}
function h(x0: int | undefined): int {
  let x = x0
  const clear = () => { x = undefined }
  if (x !== undefined) {
    clear()
    return x
  }
  return 0
}

// Top-level bindings narrow like locals: a `const` guard holds for the rest of
// the script; a `let` guard is forgotten across calls (a callee may reassign it),
// and is replaced by what later assignments give it.
type M = { v: int }
function makeM(): M | undefined { return { v: 1 } }
function noop() {}

const mg = makeM()
if (mg !== undefined) {
  noop()
  console.log(mg.v)
}

let ml = makeM()
if (ml !== undefined) {
  noop()
  console.log(ml.v)
}

let ma = makeM()
if (ma !== undefined) {
  ma = undefined
  console.log(ma.v)
}
