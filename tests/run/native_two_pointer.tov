// Two-pointer loops (`while (i < j) { ...; i++; j-- }`): the same results with indexes known in
// range before the loop (its unchecked copy) or not, and `i`, `j` stepped anywhere in the body.
function reverse(inout xs: int[]) {
  let i = 0
  let j = xs.length - 1
  while (i < j) {
    const t = xs[i]!
    xs[i] = xs[j]!
    xs[j] = t
    i++
    j--
  }
}

// a part of xs reversed in place: spans either side of the short copy's 8 (see Gen's While)
function reverseRange(inout xs: int[], from: int, to: int) {
  let i = from
  let j = to
  while (i < j) {
    const t = xs[i]!
    xs[i] = xs[j]!
    xs[j] = t
    i++
    j--
  }
}

// stops at the first pair that differs: a `break` out of the short copy
function mirrored(xs: int[], from: int, to: int): int {
  let i = from
  let j = to
  let pairs = 0
  while (i < j) {
    if (xs[i]! !== xs[j]!) break
    pairs += 1
    i++
    j--
  }
  return pairs
}

function isPalindrome(s: u8[]): bool {
  let lo = 0
  let hi = s.length - 1
  while (lo < hi) {
    lo += 1
    hi -= 1
    if (s[lo - 1]! !== s[hi + 1]!) return false
  }
  return true
}

function main() {
  let xs = [1, 2, 3, 4, 5, 6, 7]
  reverse(&xs)
  console.log(xs.join(","))
  let one = [9]
  reverse(&one)
  let none: int[] = []
  reverse(&none)
  console.log(one.join(","), none.length)
  const enc = new TextEncoder()
  console.log(isPalindrome(enc.encode("racecar")), isPalindrome(enc.encode("abca")), isPalindrome(enc.encode("")))
  // a shared array: the copy-on-write copy is the one reversed
  let a = [1, 2, 3]
  const b = a.slice()
  reverse(&a)
  console.log(a.join(","), b.join(","))
  for (const span of [0, 1, 2, 6, 7, 8, 9, 15, 16, 17]) {
    let ys: int[] = []
    for (let k = 0; k < 20; k++) ys.push(k)
    reverseRange(&ys, 2, 2 + span)
    console.log(span, ys.join(","))
  }
  const sym = [1, 2, 3, 4, 5, 9, 5, 4, 3, 2, 1]
  console.log(mirrored(sym, 0, 10), mirrored(sym, 1, 9), mirrored(sym, 0, 9), mirrored(sym, 3, 7))
  const long = [1, 2, 3, 4, 5, 6, 7, 8, 9, 9, 8, 7, 6, 5, 4, 3, 2, 1]
  console.log(mirrored(long, 0, 17), mirrored(long, 0, 16))
}
