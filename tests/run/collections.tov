type Item = { name: string, qty: int, price: f64 }

function widenLabels(labels: Map<string, string>): Map<string, string | undefined> {
  return labels
}

function main() {
  const items: Item[] = [
    { name: "apple", qty: 3, price: 0.5 },
    { name: "pear", qty: 0, price: 0.75 },
    { name: "fig", qty: 12, price: 0.2 },
    { name: "kiwi", qty: 5, price: 0.3 },
  ]
  const inStock = items.filter(i => i.qty > 0)
  console.log(inStock.map(i => i.name))
  console.log(items.reduce((sum, i) => sum + i.qty, 0), items.reduce((m, i) => Math.max(m, i.price), 0.0))
  console.log(items.some(i => i.qty === 0), items.every(i => i.price > 0.1))
  console.log(items.find(i => i.name === "fig"), items.findIndex(i => i.name === "kiwi"), items.findIndex(i => i.qty > 100))
  const byPrice = items.slice().sort((a, b) => a.price - b.price)
  console.log(byPrice.map(i => i.name).join(","))
  const nums = [5, 3, 9, 1, 7]
  console.log(nums.slice().sort((a, b) => a - b), nums.indexOf(9), nums.includes(4), nums.at(-1), nums.at(10))
  console.log(nums.slice(1, 3), nums.concat([100, 200]).join(","), nums.slice().reverse())
  console.log([[1, 2], [3]].flatMap(xs => xs.map(x => x * 2)))
  let stack: int[] = []
  stack.push(1, 2, 3)
  const top = stack.pop()
  const first = stack.shift()
  stack.unshift(0)
  console.log(top, first, stack, stack.length)

  const stock = new Map<string, int>()
  for (const i of items) stock.set(i.name, i.qty)
  stock.set("apple", 10)
  stock.delete("pear")
  stock.set("pear", 1)
  console.log(stock, stock.size, stock.has("fig"), stock.get("nope"))
  console.log(stock.keys().join(","), stock.values().join(","))
  let lines: string[] = []
  stock.forEach((qty, name) => {
    lines.push(`${name}:${qty}`)
  })
  console.log(lines.join(" "))

  const labels = new Map<string, string>()
  labels.set("apple", "fruit")
  labels.set("fig", "fruit")
  const wideLabels = widenLabels(labels)
  labels.set("apple", "changed")
  console.log(wideLabels, wideLabels.get("apple"), wideLabels.get("missing"))

  const seen = new Set<int>()
  for (const n of [3, 1, 3, 2, 1]) seen.add(n)
  console.log(seen, seen.size, seen.has(2), seen.has(9))
  let setTotal = 0
  for (const v of seen) setTotal += v
  console.log(setTotal, seen.values().join(","))

  const empty: string[] = []
  console.log(empty, empty.join("-"), [undefined, 1], { a: 1, b: "x", c: [true] })
}
