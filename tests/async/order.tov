// Microtask ordering: awaits, spawned tasks, queueMicrotask and promise chains interleave exactly as in JavaScript.
const log: string[] = []

async function depth0(): Promise<int> {
  return 0
}

async function depth1(): Promise<int> {
  await undefined
  return 1
}

async function depth2(): Promise<int> {
  await depth1()
  return 2
}

async function tagged(tag: string, n: int) {
  for (let i = 0; i < n; i++) {
    log.push(tag + String(i))
    await undefined
  }
}

async function race(name: string, f: () => Promise<int>) {
  const v = await f()
  log.push(name + "=" + String(v))
}

async function main() {
  const t = tagged("t", 6)
  race("d0", depth0)
  race("d1", depth1)
  race("d2", depth2)
  queueMicrotask(() => log.push("q"))
  log.push("sync")
  await t
  console.log(log.join(" "))

  // A value awaited by several tasks wakes them in the order they started waiting.
  const shared = depth2()
  const waiters: Promise<void>[] = []
  for (const name of ["a", "b", "c"]) {
    const w = (async () => {
      const v = await shared
      console.log(name, v)
    })()
    waiters.push(w)
  }
  for (const w of waiters) {
    await w
  }

  // `await Promise.resolve(x)` takes the one tick `await x` does, next to a then-chain.
  const ticks: string[] = []
  const viaResolve = (async () => {
    for (let i = 0; i < 3; i++) {
      const v = await Promise.resolve(i)
      ticks.push("r" + String(v))
    }
    const s = await Promise.resolve("s")
    await Promise.resolve()
    ticks.push(s)
  })()
  const viaValue = (async () => {
    for (let i = 0; i < 3; i++) {
      const v = await i
      ticks.push("v" + String(v))
    }
  })()
  Promise.resolve(0).then(() => ticks.push("p1")).then(() => ticks.push("p2"))
  await viaResolve
  await viaValue
  console.log(ticks.join(" "))
}
