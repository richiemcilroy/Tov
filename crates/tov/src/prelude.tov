// Built-in declarations visible in every module (unless a module declares the same name).

export class Error {
  message: string
  name: string = "Error"
  constructor(message?: string) {
    this.message = message ?? ""
  }
  toString(): string {
    return this.message === "" ? this.name : `${this.name}: ${this.message}`
  }
}

export class TypeError extends Error {
  constructor(message?: string) {
    super(message)
    this.name = "TypeError"
  }
}

export class RangeError extends Error {
  constructor(message?: string) {
    super(message)
    this.name = "RangeError"
  }
}

export class SyntaxError extends Error {
  constructor(message?: string) {
    super(message)
    this.name = "SyntaxError"
  }
}

/** An error thrown by JavaScript (an npm package): `value` is what was thrown; `name` and
 * `message` are its own when it's an `Error`. */
export class JsError extends Error {
  value: Js
  constructor(name: string, message: string, value: Js) {
    super(message)
    this.name = name
    this.value = value
  }
}

/** (Makes the JsError for a JavaScript exception; called by generated code.) */
export function __jsError(name: string, message: string, value: Js): JsError {
  return new JsError(name, message, value)
}

/** (An error a Tov function passes on to JavaScript: a `JsError` goes back as what JavaScript
 * threw; any other error as a JavaScript `Error` with its name and message. Called by generated
 * code.) */
export function __isJsError(e: Error): boolean {
  return e instanceof JsError
}

export function __jsErrorValue(e: Error): Js {
  return (e as JsError).value
}

export function __errorName(e: Error): string {
  return e.name
}

export function __errorMessage(e: Error): string {
  return e.message
}
