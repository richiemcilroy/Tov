// A million calls from JavaScript into a Tov function: loop.tov's other direction. JavaScript
// calls a handler the way a framework does, and each call does little work.
import { runInThisContext } from "node:vm"

const each = try runInThisContext("(cb, n) => { let s = 0; for (let i = 0; i < n; i++) s += cb(i); return s }")
const t0 = performance.now()
const s = try each((i: Js): Js => i, 1000000)
console.log(s, Math.round(performance.now() - t0))
